# Normalise line endings in the index, check out per platform, and pin the executable
# scripts to LF — a shell script with CRLF fails with "bash\r: No such file or directory"
# on Linux runners and inside containers.
* text=auto

*.java          text eol=lf
*.xml           text eol=lf
*.md            text
*.properties    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile*     text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# POSIX scripts must stay LF everywhere, including on Windows checkouts
mvnw            text eol=lf
bin/jia         text eol=lf
scripts/*.sh    text eol=lf
server/*.sh     text eol=lf

# Windows batch files must stay CRLF to be reliably executable
*.cmd           text eol=crlf

# Captured incident artifacts are byte-for-byte tool output: never touch them
corpus/** -text
*.dump    -text
*.histo   -text
*.log     -text

# Binaries
*.jar       binary
*.zip       binary
*.png       binary
*.gif       binary
*.jfr       binary
*.hprof     binary
